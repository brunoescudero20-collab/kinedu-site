# Copy this file to .env and fill in real values. Never commit .env.
# Full deploy walkthrough: docs/deployment.md

# PostgreSQL connection. In production this MUST point at a dedicated
# production database, never the local/dev one used while building this.
DATABASE_URL=postgresql://kinedu:kinedu@localhost:5432/kinedu

# Server. In production, PORT is normally supplied by the hosting platform
# itself (Render/Railway/Fly.io set it automatically) — do not hardcode a
# different value there. NODE_ENV=production disables verbose/dev-only
# behavior where it matters (currently: nothing branches on it besides the
# health check echoing it back — kept here for any future use and because
# most Node tooling expects it set).
PORT=3001
NODE_ENV=development

# CORS — comma-separated list of origins allowed to call the API from a
# browser. Locally: the split-dev-server origin (python -m http.server
# 8080). In production, once the frontend is served by this same backend
# (see docs/deployment.md), same-origin requests don't need CORS at all —
# set this to the real public HTTPS URL anyway, for any cross-origin caller
# (e.g. testing the API directly from a different host).
CORS_ORIGIN=http://localhost:8080

# Password hashing cost factor (bcrypt). 10-12 is a reasonable range.
BCRYPT_ROUNDS=12

# Agent integration (/api/agent/*) — credential for the research agent's
# service-to-service calls. NEVER the same as any user password, DB
# credential, or Anthropic API key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset to disable /api/agent/* entirely (it responds 503).
KINEDU_AGENT_API_KEY=

# Signs admin session tokens (/api/admin/*, issued at login). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset for local dev only — a random one is generated at boot, but
# every session breaks on restart. Set a real value in any long-lived
# environment.
SESSION_SECRET=

# Remote MCP server (/mcp) — bearer credential for the Claude/Cowork custom
# connector. Deliberately a DIFFERENT secret from KINEDU_AGENT_API_KEY (see
# docs/mcp.md). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset to disable /mcp entirely (it responds 503).
MCP_AUTH_SECRET=
