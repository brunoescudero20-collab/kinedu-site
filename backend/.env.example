# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection
DATABASE_URL=postgresql://kinedu:kinedu@localhost:5432/kinedu

# Server
PORT=3001
NODE_ENV=development

# CORS — comma-separated list of origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:8080

# Password hashing cost factor (bcrypt). 10-12 is a reasonable range.
BCRYPT_ROUNDS=12

# Agent integration (/api/agent/*) — credential for the research agent's
# service-to-service calls. NEVER the same as any user password, DB
# credential, or Anthropic API key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset to disable /api/agent/* entirely (it responds 503).
KINEDU_AGENT_API_KEY=
